# ── Advanced RAG Pipeline – Environment Configuration ─────────────────────────
# Copy this to .env and fill in your values.
# All settings have defaults in config.py, so .env is optional.

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ai_research

# ── Fallback LLM: Ollama (Local) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Choose any model pulled with `ollama pull <model>` (e.g. llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5


# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=6
SCORE_THRESH=0.30

# ── Main LLM: Nvidia Nemotron ─────────────────────────────────────────────────
# Option 1: Direct Nvidia API (build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Option 2: OpenRouter API (openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free


